{
  "name": "open-fan",
  "private": true,
  "version": "0.0.0",
  "description": "Node-graph fan control with typed connections.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "bindings": "cargo test -p of-units --features ts && cargo test -p of-core --features ts",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icon.mjs && tauri icon assets/icon-source.png",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@xyflow/react": "^12",
    "react": "^19",
    "react-dom": "^19",
    "uplot": "^1.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "typescript": "^5",
    "vite": "^7"
  }
}
