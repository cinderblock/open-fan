# Rust
/target
**/*.rs.bk

# Node / Bun
node_modules/
ui/dist/
.vite/

# Tauri
src-tauri/target/
src-tauri/gen/

# ts-rs scratch output. The bindings the UI imports live in ui/src/bindings/ and ARE
# committed, so the frontend builds without a Rust toolchain and type drift shows up
# in review as a diff.
crates/*/bindings/

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# Local runtime state — never commit a user's profiles or logs
/local/
*.log
src-tauri/binaries/
.latest-test.json
