<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  OpenFan requires administrator rights, and asks for them up front rather than
  discovering the problem later.

  PawnIO refuses a device handle to an unprivileged process: every call returns
  E_ACCESSDENIED. That is the whole hardware surface, not just writes — OpenFan cannot
  read a single temperature without elevation. An unelevated launch would silently fall
  back to the simulated backend and show a plausible, entirely fictional machine, which
  is a far worse outcome than a UAC prompt.

  See `plans/open-fan.md`, "PawnIO requires an elevated caller".
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="eu.openfan.OpenFan" version="1.0.0.0" />

  <!--
    Common Controls v6. Not optional and easy to lose: replacing Tauri's default manifest
    drops its declaration, after which the process binds to comctl32 v5, fails to resolve
    `TaskDialogIndirect`, and dies behind a modal "Entry Point Not Found" box before a
    single line of our code runs. Which is exactly what happened when this manifest was
    first written.
  -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*" />
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. Declaring these keeps the OS from applying compatibility
           shims that would, among other things, lie to us about the OS version. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
