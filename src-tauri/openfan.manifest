<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  OpenFan runs **unelevated**, and that is the whole point of the service.

  PawnIO refuses a device handle to an unprivileged process, so something must be
  elevated to touch the hardware at all — but it is the OpenFan service, which starts at
  boot as LocalSystem and holds that handle for the machine's lifetime. This window is
  only a client of it, so asking a person for administrator every time they want to look
  at a fan curve would be gratuitous.

  It also restores autostart: Windows will not launch an elevated application from the
  Run key, so `requireAdministrator` and "start with Windows" were mutually exclusive.

  See `plans/open-fan.md`, "When to elevate".
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="eu.openfan.OpenFan" version="1.0.0.0" />

  <!--
    Common Controls v6. Not optional and easy to lose: replacing Tauri's default manifest
    drops its declaration, after which the process binds to comctl32 v5, fails to resolve
    `TaskDialogIndirect`, and dies behind a modal "Entry Point Not Found" box before a
    single line of our code runs. Which is exactly what happened when this manifest was
    first written.
  -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*" />
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. Declaring these keeps the OS from applying compatibility
           shims that would, among other things, lie to us about the OS version. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
